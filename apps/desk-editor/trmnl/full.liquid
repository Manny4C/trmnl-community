<div class="layout layout--col gap--xsmall">
{% if image_url %}<div class="nf-photo"><img class="image image-dither image--cover" src="{{ image_url | escape }}" alt="{{ image_caption | escape }}"></div>{% endif %}
<div class="nf-copy flex flex--col flex--left gap--xsmall w--full">
<div class="label label--small lg:label--base" data-clamp="1">{{ source | escape }}{% if published_at %} · {{ published_at | date: "%s" | plus: trmnl.user.utc_offset | date: "%b %d %H:%M" }}{% endif %}{% if image_kind == 'video_thumbnail' %} · VIDEO PREVIEW{% endif %}</div>
<div class="text--xlarge lg:text--xxlarge text--bold" data-clamp="2" data-clamp-lg="2">{{ headline | escape }}</div>
<div class="label label--small lg:label--base" data-clamp="1">{{ reason | escape }}</div>
{% if image_credit %}<div class="label label--small lg:label--base" data-clamp="1">Image: {{ image_credit | escape }} · checked {{ checked_at | date: "%s" | plus: trmnl.user.utc_offset | date: "%H:%M" }}</div>{% endif %}
</div></div>
{% render 'title_bar', stale: stale, selection_method: selection_method, partial: partial %}
