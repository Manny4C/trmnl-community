<div class="layout layout--row layout--stretch-y portrait:layout--col gap--small">
{% if image_url %}<div class="nf-row-photo"><img class="image image-dither image--cover" src="{{ image_url | escape }}" alt="{{ image_caption | escape }}"></div>{% endif %}
<div class="nf-row-copy flex flex--col flex--left flex--center-y gap--xsmall">
<span class="label label--small lg:label--base" data-clamp="1">{{ source | escape }}{% if image_kind == 'video_thumbnail' %} · VIDEO{% endif %}</span>
<div class="text--large lg:text--xlarge text--bold" data-clamp="3">{{ headline | escape }}</div>
<div class="label label--small lg:label--base" data-clamp="1" data-clamp-lg="2">{{ reason | escape }}</div>
<span class="label label--small lg:label--base" data-clamp="1">{% if published_at %}{{ published_at | date: "%b %d" }} · {% endif %}Image: {{ image_credit | default: source | escape }}</span>
</div></div>
{% render 'title_bar', stale: stale, selection_method: selection_method, partial: partial %}
