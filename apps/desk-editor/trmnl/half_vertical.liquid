<div class="layout layout--col gap--xsmall">
{% if image_url %}<div class="nf-photo"><img class="image image-dither image--cover" src="{{ image_url | escape }}" alt="{{ image_caption | escape }}"></div>{% endif %}
<div class="nf-copy flex flex--col flex--left gap--xsmall w--full">
<span class="label label--small lg:label--base" data-clamp="1">{{ source | escape }}{% if image_kind == 'video_thumbnail' %} · VIDEO PREVIEW{% endif %}</span>
<div class="text--large lg:text--xlarge text--bold" data-clamp="3">{{ headline | escape }}</div>
<div class="label label--small lg:label--base" data-clamp="2">{{ reason | escape }}</div>
<span class="label label--small lg:label--base" data-clamp="1">Image: {{ image_credit | default: source | escape }}{% if published_at %} · {{ published_at | date: "%b %d" }}{% endif %}</span>
</div></div>
{% render 'title_bar', stale: stale, selection_method: selection_method, partial: partial %}
