{% assign lead = cards.first %}
<div class="layout layout--col gap--xsmall">
{% if lead %}<span class="label label--small lg:label--base">{{ lead.kind | upcase }}{% if lead.stale %} · CACHED{% endif %}</span><div class="text--large lg:text--xlarge text--bold de-line" data-clamp="3">{{ lead.title | escape }}</div><div class="label label--small lg:label--base de-line" data-clamp="2">{{ lead.reason | escape }}</div><span class="label label--small lg:label--base de-line" data-clamp="1">{{ lead.source | escape }}</span>{% else %}<div class="description">Waiting for the next edition.</div>{% endif %}
</div>
{% render 'title_bar', phase: phase, partial: partial %}
