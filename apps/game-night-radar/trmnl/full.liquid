<div class="layout layout--col gap--xsmall lg:gap--small flex--top">
{% render 'radar_header',days:days %}
<span class="label label--small lg:label--base w--full" data-clamp="1">{% for game in games %}{{ game[1] | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}</span>
{% render 'radar_rows', items:items, max_cols:2, lines:2, title_size:'title--small lg:title--large', label_size:'label--small lg:label--large' %}
{% render 'radar_status',stale:stale,partial:partial,status:status,source_checked_at:source_checked_at %}
<span class="label label--small lg:label--base">Links: game-night-radar.vercel.app · Steam developer posts</span>
</div>{% render 'title_bar',checked_at:checked_at %}
