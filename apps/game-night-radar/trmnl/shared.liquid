{% template title_bar %}<div class="title_bar"><span class="title">Game Night Radar</span><span class="instance">{{ checked_at | date: "%H:%M" }} UTC</span></div>{% endtemplate %}
{% template radar_header %}<div class="flex flex--row flex--between gap--small w--full"><span class="title title--small lg:title--large text--red 1bit:text--black 2bit:text--black 4bit:text--black">GAME NIGHT RADAR</span><span class="label label--small lg:label--base bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black">{{ days | default: 30 }} DAYS</span></div>{% endtemplate %}
{% template radar_rows %}
{% if items.size > 0 %}<div class="columns stretch w--full" data-overflow-max-cols="{{ max_cols | default: 1 }}" data-overflow-max-cols-lg="2" data-overflow-max-cols-portrait="1" data-overflow-counter="true"><div class="column">
{% for item in items %}<div class="item"><div class="meta"><span class="index">{{ forloop.index }}</span></div><div class="content">
<span class="title title--small lg:title--base" data-clamp="{{ lines | default: 2 }}">{{ item.title | escape }}</span>
<span class="label label--small lg:label--base" data-clamp="2">{{ item.game | escape }} · {% if item.is_new %}<span class="bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black">NEW</span> · {% endif %}{{ item.kind | escape }} · {{ item.published_at | date: "%b %d" }}</span>
</div></div>{% endfor %}</div></div>
{% else %}<div class="flex flex--col flex--center stretch w--full"><span class="title title--small">No matching posts</span><span class="description">Try a longer window or all announcements.</span></div>{% endif %}
{% endtemplate %}
{% template radar_status %}<span class="label label--small lg:label--base w--full" data-clamp="1">{% if stale %}CACHED · Source {{ source_checked_at | date: "%b %d %H:%M" }} UTC{% elsif partial %}PARTIAL · Some games unavailable{% else %}{{ status | default: 'Steam developer announcements' | escape }}{% endif %}</span>{% endtemplate %}
