{% template title_bar %}<div class="title_bar"><span class="title">Local Morning Brief</span><span class="instance">{{ checked_at | date: "%s" | plus: trmnl.user.utc_offset | date: "%H:%M" }}</span></div>{% endtemplate %}
{% template heading %}<div class="flex flex--row flex--between w--full gap--small"><span class="{% if compact %}label label--base lg:label--large text--bold{% else %}title title--small lg:title--large{% endif %} text--red 1bit:text--black 2bit:text--black 4bit:text--black">{{ city | default: 'Local Morning Brief' | escape }}</span><span class="label label--small lg:label--base" data-clamp="1">{{ date | escape }}</span></div>{% endtemplate %}
{% template weather %}<div class="flex flex--row gap--small w--full flex--left">{% if forecast %}<span class="value {% if compact %}value--xxsmall lg:value--small{% else %}value--small lg:value--base{% endif %}">{{ forecast.temperature }}°{{ forecast.units }}</span><div class="flex flex--col flex--left gap--none"><span class="{% if compact %}text--small lg:text--base{% else %}text--base lg:text--large{% endif %} text--bold" data-clamp="1">{{ forecast.period | escape }} · {{ forecast.summary | escape }}</span><span class="label label--small lg:label--base" data-clamp="1">FORECAST · Rain {% if forecast.rain != nil %}{{ forecast.rain }}%{% else %}not supplied{% endif %} · {{ forecast.wind | escape }}</span></div>{% else %}<span class="description">NWS forecast unavailable</span>{% endif %}</div>{% endtemplate %}
{% template alert_line %}<span class="label label--small lg:label--base bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black w--full" data-clamp="1">{% if alert_status == 'unavailable' %}NWS alert check unavailable{% elsif alert_count > 0 %}{{ alert_count }} NWS alert(s) · {{ alerts[0] | escape }}{% else %}No active NWS alerts returned for this point{% endif %}</span>{% endtemplate %}
{% template transit_rows %}<div class="flex flex--col flex--left gap--none w--full border--top"><span class="label label--small lg:label--base text--bold{% if compact %} hidden{% endif %}">BART · NETWORK ADVISORIES</span>{% if transit_status == 'unavailable' %}<span class="text--small lg:text--base">BART check unavailable · open the agency source</span>{% else %}{% for row in transit limit: limit %}<span class="text--small lg:text--base w--full" data-clamp="{{ lines | default: 2 }}">{% if compact %}BART · {% endif %}{{ row | escape }}</span>{% endfor %}{% endif %}</div>{% endtemplate %}
{% template update_rows %}
{% if items.size > 0 %}<div class="columns stretch w--full" data-overflow-max-cols="{{ max_cols | default: 1 }}" data-overflow-max-cols-lg="{{ max_cols_lg | default: 2 }}" data-overflow-max-cols-portrait="1" data-overflow-max-cols-lg-portrait="1" data-overflow-counter="true"><div class="column">
{% for item in items %}<div class="item"><div class="meta"></div><div class="content"><span class="title {{ title_size | default: 'title--small lg:title--base' }}" data-clamp="{{ lines | default: 2 }}">{{ item[0] | escape }}</span><span class="label label--small lg:label--base" data-clamp="1">{{ item[1] | escape }} · {{ item[2] | escape }}{% if item[3] == 'Date in source URL' %} (URL date){% endif %}</span></div></div>{% endfor %}
</div></div>{% else %}<span class="description stretch">No dated updates · check source status online</span>{% endif %}
{% endtemplate %}
{% template status_line %}<span class="label label--small lg:label--base w--full" data-clamp="1">{% if partial %}PARTIAL · {% endif %}WX {{ sources.weather.status | escape }} · Alerts {{ sources.alerts.status | escape }} · BART {{ sources.transit.status | escape }} · Check official sources before travel</span>{% endtemplate %}
