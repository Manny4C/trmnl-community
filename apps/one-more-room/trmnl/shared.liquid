<style>
/* Original SVG atlas camera and path geometry cannot be expressed with list/layout utilities. */
.q-atlas{position:relative;min-height:60px;overflow:hidden}.q-map-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.q-map{position:absolute;inset:0;width:100%;height:100%}.q-map-roads{fill:none;stroke:#000;stroke-width:1.1;stroke-dasharray:3 3}.q-map-trail{fill:none;stroke:#000;stroke-width:2.3;stroke-dasharray:4 3}.q-waypoint.c0{display:none}.q-room-node,.q-world-node{fill:#fff;stroke:#000;stroke-width:1.05}.q-waypoint.c1 .q-room-node{stroke-dasharray:2 2}.q-waypoint.c3 .q-room-node,.q-waypoint.c3 .q-world-node{stroke-width:3}.q-node-glyph{font-size:8px;text-anchor:middle;fill:#000}.q-map-label{font-size:9px;text-anchor:middle;fill:#000;paint-order:stroke;stroke:#fff;stroke-width:3px}.q-art{min-height:60px;overflow:hidden}.q-scene-image{width:100%;height:100%;object-fit:cover}
</style>
{% template quest_content %}
<div class="layout layout--col gap--small">
<div class="flex flex--row flex--between w--full gap--small"><span class="title title--small lg:title--base text--red 1bit:text--black 2bit:text--black 4bit:text--black">ONE MORE ROOM</span><span class="label label--small" data-clamp="1">TURN {{ turn }} · {{ status | escape }}</span></div>
<div class="flex {% if mode == 'half_vertical' %}flex--col{% else %}flex--row portrait:flex--col{% endif %} stretch w--full {% if mode == 'full' or mode == 'half_horizontal' %}gap--medium{% else %}gap--small{% endif %}">
<section class="flex flex--col flex--left stretch w--full gap--xsmall">
<span class="label label--small" data-clamp="1">{{ map_context | escape }} · {{ map_title | escape }}</span>
<div class="q-atlas stretch w--full"><img class="q-map-art image-dither" src="https://one-more-room-trmnl.vercel.app/art/{% if map_mode == 'world' %}atlas{% else %}dungeon-atlas{% endif %}-v2.jpg" alt="Original fantasy atlas"><svg class="q-map" viewBox="{{ map_box | escape }}" aria-label="{{ map_context | escape }}"><path class="q-map-roads" d="{{ map_roads | escape }}"/><path class="q-map-trail" d="{{ map_trail | escape }}"/>{% for point in map_points %}<g class="q-waypoint c{{ point[2] }}" transform="translate({{ point[0] }} {{ point[1] }})">{% if map_mode == 'world' %}<circle class="q-world-node" r="5"/>{% else %}<rect class="q-room-node" x="-11" y="-8" width="22" height="16" rx="2"/>{% endif %}<text class="q-node-glyph" y="3">{% if point[2] == 3 %}◆{% else %}{{ point[4] | escape }}{% endif %}</text>{% if point[3] != '' %}<text class="q-map-label" y="20">{{ point[3] | escape }}</text>{% endif %}</g>{% endfor %}</svg></div>
<span class="label label--small" data-clamp="1">◆ Company · Journey trail · {{ map_caption | escape }}</span>
{% if mode == 'full' %}<span class="description" data-clamp="2">{{ objective | escape }}</span>
<div class="flex flex--col gap--xsmall w--full" data-overflow="true" data-overflow-counter="true">{% for event in recap %}<div class="item"><div class="content"><span class="description" data-clamp="2">{{ event | escape }}</span></div></div>{% endfor %}</div>{% endif %}
<div class="{% unless mode == 'full' %}hidden{% endunless %} grid grid--cols-2 lg:grid--cols-4 gap--xsmall w--full">{% for hero in party %}<div class="q-hero flex flex--col flex--left"><span class="label label--small text--bold">{{ hero.name | escape }}</span><span class="label label--small">{{ hero.hp }}/{{ hero.max }} HP</span></div>{% endfor %}</div>
</section>
<section class="flex flex--col flex--left {% unless mode == 'half_vertical' %}stretch{% endunless %} w--full gap--xsmall">
{% assign art_key = kind %}{% if safe and kind == 'battle' %}{% assign art_key = 'passage' %}{% elsif safe and kind == 'keeper' %}{% assign art_key = 'shrine' %}{% endif %}
<div class="q-art {% if mode == 'full' %}stretch{% else %}hidden{% endif %} w--full"><img class="q-scene-image image-dither" src="https://one-more-room-trmnl.vercel.app/art/{{ art_key }}-v2.jpg" alt="Illustrated {{ kind | escape }} encounter"></div>
<span class="title title--small lg:title--base" data-clamp="2">{{ title | escape }}</span>
<span class="description" data-clamp="{% if mode == 'full' %}4{% else %}2{% endif %}" data-clamp-lg="6">{{ text | escape }}</span>
<span class="{% unless mode == 'full' %}hidden lg:visible{% endunless %} label label--small" data-clamp="1">{{ roll | escape }}</span>
{% assign automatic_choices = choices | where: 'auto', true %}{% assign other_choices = choices | where: 'auto', false %}{% assign next_choices = automatic_choices | concat: other_choices %}<div class="flex flex--col {% unless mode == 'full' %}stretch{% endunless %} w--full gap--xsmall" data-overflow="true" data-overflow-counter="true">{% for choice in next_choices %}<div class="item {% unless mode == 'full' or choice.auto %}hidden lg:visible{% endunless %} {% if choice.auto %}q-auto bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black{% endif %}"><div class="content"><span class="description" data-clamp="2">{% if choice.auto %}AUTO → {% endif %}{{ choice.label | escape }}</span></div></div>{% endfor %}</div>
</section></div></div>
<div class="title_bar"><span class="title">One More Room</span><span class="instance" data-clamp="1">Floor {{ floor }} · {{ gold }} gold · {{ supplies }} supplies · {{ relics }} embers</span></div>
{% endtemplate %}
