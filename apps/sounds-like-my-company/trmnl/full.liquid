{% assign result_limit = result_count | default: 6 | plus: 0 %}
{% if result_limit == 3 %}{% assign columns = 'grid--cols-1' %}{% assign title_size = 'text--large lg:text--xxlarge' %}{% assign title_lines = 1 %}{% elsif result_limit == 8 %}{% assign columns = 'grid--cols-2' %}{% assign title_size = 'text--base lg:text--xlarge' %}{% assign title_lines = 1 %}{% else %}{% assign columns = 'grid--cols-2' %}{% assign title_size = 'text--base lg:text--xlarge' %}{% assign title_lines = 2 %}{% endif %}
<div class="layout layout--col gap--small sm--full">
{% render 'radar_header', name: name, window_days: window_days, order: order, stale: stale, partial: partial %}
<div class="sm-cards grid {{ columns }} gap--small w--full">{% for item in matches limit: result_limit %}{% render 'launch_card', item: item, index: forloop.index, title_size: title_size, title_lines: title_lines %}{% else %}<div class="sm-empty description lg:description--large">Nothing in your orbit yet.<br>Try a wider window or fewer filters.</div>{% endfor %}</div>
<div class="flex flex--row flex--between w--full shrink-0"><span class="label label--small lg:label--base">{{ matches.size }} launch{% unless matches.size == 1 %}es{% endunless %} to explore</span><span class="label label--small lg:label--base">Shared wording ≠ direct competitor</span></div>
</div>
{% render 'title_bar', checked_at: checked_at %}
