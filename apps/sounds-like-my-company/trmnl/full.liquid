<div class="layout layout--col"><div class="sm sm--full{% if matches.size > 6 %} sm--dense{% elsif matches.size <= 3 %} sm--roomy{% endif %}">
<div class="sm-head"><span class="sm-brand">SOUNDS LIKE MY COMPANY</span><span class="sm-window">{{ window_days }} days</span></div>
<div class="sm-profile">{{ name | escape }} · {% if order == 'latest' %}Newest matches{% else %}Closest wording{% endif %}{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL{% endif %}</div>
<div class="sm-cards">{% for item in matches limit: 8 %}<div class="sm-card"><div class="sm-row"><div class="sm-title">{{ item.title | escape }}</div><div class="sm-meta">{{ item.source | escape }} · {{ item.published_at | date: "%b %d" }}</div></div><div class="sm-reason">{{ item.reason | escape }}</div></div>{% else %}<div class="sm-empty">No matching announcements.<br>Try a wider window or fewer filters.</div>{% endfor %}</div>
<div class="sm-foot"><span>Checked {{ checked_at | date: "%b %d %H:%M" }} UTC</span><span>Shared wording ≠ direct competitor</span></div>
</div></div>