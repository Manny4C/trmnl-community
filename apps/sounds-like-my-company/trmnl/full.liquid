{% assign result_limit = result_count | default: 6 | plus: 0 %}
{% if result_limit == 3 %}{% assign title_lines = 2 %}{% assign title_size = 'text--xlarge lg:text--xxlarge' %}{% assign reason_size = 'label lg:label--xlarge' %}{% elsif result_limit == 8 %}{% assign title_lines = 1 %}{% assign title_size = 'text--base lg:text--xlarge' %}{% assign reason_size = 'label label--small lg:label--base' %}{% else %}{% assign title_lines = 1 %}{% assign title_size = 'text--large lg:text--xxlarge' %}{% assign reason_size = 'label label--small lg:label--xlarge' %}{% endif %}
<div class="layout layout--col gap--small sm--full">
<div class="flex flex--row flex--between gap--small w--full shrink-0"><span class="label label--base lg:label--large sm-profile">{{ name | escape }} · {% if order == 'latest' %}Newest matches{% else %}Closest wording{% endif %}{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL{% endif %}</span><span class="label label--small lg:label--base shrink-0">{{ window_days }}d</span></div>
<div class="flex flex--col flex--stretch-x w--full sm-cards">{% for item in matches limit: result_limit %}<div class="sm-card flex flex--col flex--left flex--center-y gap--xsmall w--full">{% unless forloop.first %}<div class="border--h-black w--full shrink-0"></div>{% endunless %}<div class="flex flex--row flex--between gap--small w--full"><div class="sm-title text--bold {{ title_size }}" data-clamp="{{ title_lines }}" data-clamp-lg="{{ title_lines }}">{{ item.title | escape }}</div><div class="sm-meta label label--small lg:label--base shrink-0">{{ item.source | escape }} · {{ item.published_at | date: "%b %d" }}</div></div><div class="sm-reason {{ reason_size }}" data-clamp="1">{{ item.reason | escape }}</div></div>{% else %}<div class="sm-empty description lg:description--large">No matching announcements.<br>Try a wider window or fewer filters.</div>{% endfor %}</div>
<span class="label label--small lg:label--base shrink-0">Shared wording ≠ direct competitor</span></div>
{% render 'title_bar', checked_at: checked_at %}
