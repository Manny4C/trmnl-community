<div class="layout layout--col gap--small sm--compact sm--quadrant">
<div class="flex flex--row flex--between gap--small w--full shrink-0"><span class="label label--base lg:label--large sm-profile">{{ name | escape }} · {% if order == 'latest' %}Newest matches{% else %}Closest wording{% endif %}{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL{% endif %}</span></div>
<div class="flex flex--col flex--stretch-x w--full sm-cards">{% for item in matches limit: 1 %}<div class="sm-card flex flex--col flex--left flex--center-y gap--xsmall w--full">{% unless forloop.first %}<div class="border--h-black w--full shrink-0"></div>{% endunless %}<div class="flex flex--col flex--left gap--xsmall w--full"><div data-clamp="2" class="sm-title text--bold text--large lg:text--xlarge">{{ item.title | escape }}</div><div class="sm-meta label label--small lg:label--base">{{ item.source | escape }} · {{ item.published_at | date: "%b %d" }}</div></div><div data-clamp="2" class="sm-reason label label--small lg:label--large">{{ item.reason | escape }}</div></div>{% else %}<div class="sm-empty description lg:description--large">No matching announcements.<br>Try a wider window or fewer filters.</div>{% endfor %}</div>
</div>
{% render 'title_bar', checked_at: checked_at %}
