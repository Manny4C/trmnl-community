{% template title_bar %}
<div class="title_bar bg--white"><span class="title">Sounds Like My Company</span><span class="instance">{{ checked_at | date: "%H:%M" }} UTC</span></div>
{% endtemplate %}
{% template radar_header %}
<div class="sm-masthead flex flex--row flex--between gap--small w--full shrink-0">
  <div class="flex flex--row flex--left gap--small sm-heading">
    <div class="sm-signal bg--red 1bit:bg--black text--white"><span></span><span></span><span></span></div>
    <div class="flex flex--col flex--left gap--xsmall sm-heading"><span class="label label--small lg:label--base text--bold">YOUR LAUNCH RADAR{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL{% endif %}</span><div class="sm-company text--xlarge lg:text--xxlarge text--bold" data-clamp="1">{{ name | default: 'Your company' | escape }}</div></div>
  </div>
  <div class="sm-edition flex flex--col flex--right gap--xsmall"><span class="sm-window label label--small lg:label--base bg--yellow 1bit:bg--white px--2 py--1">{{ window_days }} DAY WINDOW</span><span class="label label--small lg:label--base">{% if order == 'latest' %}Newest first{% else %}Closest wording{% endif %}{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL{% endif %}</span></div>
</div>
{% endtemplate %}
{% template launch_card %}
<article class="sm-card flex flex--col flex--left gap--xsmall bg--white p--2 lg:p--3">
  <div class="sm-card-meta flex flex--row flex--between w--full gap--small"><div class="flex flex--row flex--left gap--small"><span class="sm-number label label--small lg:label--base text--bold text--red 1bit:text--black">{% if index < 10 %}0{% endif %}{{ index }}</span><span class="sm-source label label--small lg:label--base text--bold {% if item.source == 'Launch HN' %}bg--yellow 1bit:bg--white{% else %}bg--black text--white{% endif %} px--1 py--0">{{ item.source | escape }}</span></div><span class="label label--small lg:label--base">{{ item.published_at | date: "%b %d" }}</span></div>
  <div class="sm-title {{ title_size }} text--bold w--full" data-clamp="{{ title_lines }}" data-clamp-lg="{{ title_lines }}">{{ item.title | escape }}</div>
  <div class="sm-reason label label--small lg:label--base w--full" data-clamp="1">↳ {{ item.reason | remove: 'Required keyword: ' | remove: 'Shared product wording: ' | remove: 'Related topic: ' | escape }}</div>
</article>
{% endtemplate %}
<style>
/* Fixed e-paper panels need equal card tracks; color and typography use framework utilities. */
.sm-heading,.sm-company,.sm-title{min-width:0}.sm-company{line-height:1.05}.sm-masthead{padding-bottom:10px;border-bottom:3px solid currentColor}.sm-signal{width:48px;height:48px;display:flex;align-items:center;justify-content:center;gap:4px;flex-shrink:0}.sm-signal span{display:block;width:4px;background:currentColor}.sm-signal span:nth-child(1){height:12px}.sm-signal span:nth-child(2){height:26px}.sm-signal span:nth-child(3){height:18px}.sm-window{border:1px solid currentColor;white-space:nowrap}.sm-edition{flex-shrink:0}.sm-cards{flex:1;min-height:0;min-width:0;grid-auto-rows:minmax(0,1fr)}.sm-card{min-height:0;min-width:0;overflow:hidden;border:1px solid currentColor;justify-content:flex-start}.sm-card-meta{flex-shrink:0}.sm-title{line-height:1.15;flex-shrink:0}.sm-reason{margin-top:auto;min-width:0;text-align:left}.sm-number{min-width:18px}.sm-source{white-space:nowrap}.sm-empty{grid-column:1/-1;align-self:center;justify-self:center}.sm--compact .sm-masthead{padding-bottom:6px;border-bottom-width:2px}.sm--compact .sm-signal{width:32px;height:32px;gap:3px}.sm--compact .sm-signal span{width:3px}.sm--compact .sm-signal span:nth-child(2){height:22px}.sm--compact .sm-edition{display:none}.sm--quadrant .sm-signal{display:none}.sm--quadrant .sm-card{border:0;padding:0}.sm--quadrant .sm-masthead{padding-bottom:4px}
</style>
