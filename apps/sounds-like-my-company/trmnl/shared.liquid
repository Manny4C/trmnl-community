{% comment %}Native Framework items and overflow fit every available item to OG/X and portrait mashups.{% endcomment %}
{% template feed_view %}
{% assign item_limit = result_count | default: 6 | plus: 0 %}
<div class="layout layout--col gap--small sm--{{ mode }}">
<span class="title title--small lg:title--base text--red 1bit:text--black 2bit:text--black 4bit:text--black" data-clamp="1">YOUR LAUNCH RADAR</span>
<span class="label label--small lg:label--base w--full" data-clamp="2">{{ name | default: "Your company" | escape }} · {{ window_days }} days · {% if order == "latest" %}Newest first{% else %}Closest wording{% endif %}{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL{% endif %}</span>
{% if links_code and links_qr_url %}<div class="flex flex--row gap--small flex--left w--full"><img class="w--[82px] h--[82px] shrink-0" src="{{ links_qr_url | escape }}" alt="Open launch links"><span class="label label--small" data-clamp="2">Links: {{ links_code | escape }} · Shared wording ≠ direct competitor</span></div>{% endif %}
{% if matches.size > 0 %}
<div class="columns stretch w--full" data-overflow-max-cols="{{ max_cols }}" data-overflow-max-cols-lg="2" data-overflow-max-cols-portrait="1" data-overflow-max-cols-lg-portrait="{{ portrait_cols }}" data-overflow-counter="true">
<div class="column">
{% for item in matches limit: item_limit %}
<div class="item sm-card"><div class="meta"><span class="index">{{ forloop.index }}</span></div><div class="content">
<span class="title title--small lg:title--base sm-title" data-clamp="{{ title_lines }}" data-clamp-lg="2">{{ item.title | escape }}</span>
<span class="description" data-clamp="{{ description_lines }}" data-clamp-lg="3">{{ item.reason | remove: "Required keyword: " | remove: "Shared product wording: " | remove: "Related topic: " | escape }}</span>
<span class="label label--small lg:label--base" data-clamp="1">{{ item.source | escape }} · {{ item.published_at | date: "%b %d, %Y" }}</span>
</div></div>
{% endfor %}
</div></div>
{% else %}<div class="flex flex--col flex--center stretch w--full"><span class="description">Nothing in your orbit yet. Try a wider window or fewer filters.</span></div>{% endif %}
</div>
<div class="title_bar"><span class="title text--red 1bit:text--black 2bit:text--black 4bit:text--black">Sounds Like My Company</span><span class="instance">{{ checked_at | date: "%b %d %H:%M" }} UTC</span></div>
{% endtemplate %}
