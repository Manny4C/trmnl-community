<div class="layout layout--col gap--xsmall tp--horizontal">{% render 'tp_head',chapter:chapter %}
{% if tiles.size > 0 %}<div class="flex flex--row portrait:flex--col stretch w--full gap--small"><div class="stretch w--full h--full">{% render 'tp_map',tiles:tiles,cell_type:'text--base lg:text--large' %}</div><div class="flex flex--col flex--left gap--xsmall"><span class="title title--small">{{ groves }} / 8 groves</span>{% render 'tp_resources',water:water,seeds:seeds,wood:wood,stone:stone %}<span class="label label--small" data-clamp="2">8 groves + beacon → Sail</span><span class="label label--small" data-clamp="2">Owner autopilot: {{ last_autopilot_day | default: 'pending' }}</span></div></div><span class="label label--small">Play: tiny-planet-trmnl.vercel.app</span>{% else %}<span class="description">Planet unavailable. Check website.</span>{% endif %}</div>{% render 'title_bar',turn:turn,checked_at:checked_at %}
