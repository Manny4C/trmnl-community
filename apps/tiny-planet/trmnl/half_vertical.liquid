<div class="layout layout--col gap--xsmall tp--vertical">{% render 'tp_head',chapter:chapter %}
{% if tiles.size > 0 %}<div class="tp-body"><div class="tp-board">{% render 'tp_map',tiles:tiles,cell_type:'text--base lg:text--large' %}</div><div class="tp-info flex flex--col flex--left gap--xsmall"><span class="title title--small">{{ groves }} / 8 groves</span><span class="description">8 groves + a beacon.<br>Then sail together.</span>{% render 'tp_resources',water:water,seeds:seeds,wood:wood,stone:stone %}<span class="label label--small" data-clamp="2">Owner autopilot: {{ last_autopilot_day | default: 'pending' }}</span></div></div><span class="label label--small">tiny-planet-trmnl.vercel.app</span>{% else %}<span class="description">Planet unavailable. Check website.</span>{% endif %}</div>{% render 'title_bar',turn:turn,checked_at:checked_at %}
