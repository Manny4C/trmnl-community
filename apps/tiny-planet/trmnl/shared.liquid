{% template title_bar %}<div class="title_bar"><span class="title">Tiny Planet</span><span class="instance">Turn {{ turn | default: 0 }} · {{ checked_at | date: "%H:%M" }} UTC</span></div>{% endtemplate %}
{% template tp_head %}<div class="flex flex--row flex--between w--full gap--small"><span class="title title--small lg:title--large text--red 1bit:text--black 2bit:text--black 4bit:text--black">TINY PLANET</span><span class="label label--small lg:label--base bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black">ISLAND {{ chapter | default: 1 }}</span></div>{% endtemplate %}
{% template tp_map %}
<div class="tp-map">{% for row in tiles %}<div class="tp-row">{% for tile in row %}<span class="tp-cell text--bold {{ cell_type | default: 'text--large lg:text--xlarge' }} {% if tile == '~' %}bg--black text--white{% elsif tile == 's' or tile == 'B' %}bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black{% elsif tile == 'T' %}text--red 1bit:text--black 2bit:text--black 4bit:text--black{% else %}text--black bg--white{% endif %}">{{ tile | escape }}</span>{% endfor %}</div>{% endfor %}</div>
{% endtemplate %}
{% template tp_resources %}<div class="flex flex--col flex--left gap--xsmall"><span class="label label--small lg:label--base">{{ water }} water · {{ seeds }} seeds</span><span class="label label--small lg:label--base">{{ wood }} wood · {{ stone }} stone</span></div>{% endtemplate %}
<style>
/* Only the original 8 x 6 game board needs custom geometry. Typography and inks use native utilities. */
.tp-body{display:flex;flex:1;min-height:0;width:100%;gap:16px}.tp-board{flex:1.6;min-width:0;min-height:0}.tp-info{flex:1;min-width:0;overflow:hidden}.tp-map{display:grid;grid-template-rows:repeat(6,minmax(0,1fr));height:100%;width:100%;gap:3px}.tp-row{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:3px}.tp-cell{display:flex;align-items:center;justify-content:center;min-height:0;min-width:0;border:1px solid #000}.tp--vertical .tp-body{flex-direction:column;gap:8px}.tp--vertical .tp-board{flex:1.4}.tp--quadrant .tp-info{display:none}.screen--portrait .tp--full .tp-body{flex-direction:column}.screen--portrait .tp--full .tp-board{flex:1.4}
</style>
