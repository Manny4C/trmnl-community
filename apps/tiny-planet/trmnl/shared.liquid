{% template title_bar %}<div class="title_bar"><span class="title">Tiny Planet</span><span class="instance">Turn {{ turn | default: 0 }} · {{ checked_at | date: "%s" | plus: trmnl.user.utc_offset | date: "%H:%M" }}</span></div>{% endtemplate %}
{% template tp_head %}<div class="flex flex--row flex--between w--full gap--small"><span class="title title--small lg:title--large text--red 1bit:text--black 2bit:text--black 4bit:text--black">TINY PLANET</span><span class="label label--small lg:label--base bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black">ISLAND {{ chapter | default: 1 }}</span></div>{% endtemplate %}
{% template tp_map %}
{% assign image_url = planet_image %}{% unless image_url %}{% assign image_url = 'https://tiny-planet-trmnl.vercel.app/api/planet?v=' | append: turn %}{% endunless %}
<div class="tp-planet"><img class="image image--contain image-dither w--full h--full" src="{{ image_url | escape }}" alt="3D shared planet: trees, mountains and beacon reflect our saved moves"></div>
{% endtemplate %}
{% template tp_resources %}<div class="flex flex--col flex--left gap--xsmall"><span class="label label--small lg:label--base">{{ water }} water · {{ seeds }} seeds</span><span class="label label--small lg:label--base">{{ wood }} wood · {{ stone }} stone</span></div>{% endtemplate %}
<style>
/* Projected 3D world, adapted to device inks by native image dithering. */
.tp-planet{width:100%;height:100%;min-height:0;min-width:0;display:flex;align-items:center;justify-content:center;overflow:hidden}.tp-planet img{object-fit:contain;max-width:100%;max-height:100%}
.tp-map{display:grid;grid-template-rows:repeat(6,minmax(0,1fr));height:100%;width:100%;gap:3px}.tp-row{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:3px}.tp-cell{display:flex;align-items:center;justify-content:center;min-height:0;min-width:0;border:1px solid #000}
</style>
