{% template canvas_screen %}
<div class="draws-screen w--full h--full"><div class="draws-canvas">
{% if image_color_url %}
<img class="draws-art image-dither" src="{{ image_color_url | escape }}" alt="TRMNL Draws shared canvas, revision {{ version }}">
<div class="draws-join bg--white text--black"><img class="draws-qr" src="{{ qr_url | escape }}" alt="Scan for today's TRMNL-verified drawing access"><div class="draws-code"><span class="label label--small text--bold" data-pixel-perfect="true">{{ entry_code | escape }}</span><span class="label label--small text--bold" data-pixel-perfect="true">10/day</span></div></div>
{% else %}<div class="layout layout--col"><span class="title title--small">Shared canvas unavailable</span><span class="description">TRMNL Draws · please try again later.</span></div>{% endif %}
</div></div>
{% endtemplate %}
<style>
/* Preserve the shared 5:3 canvas and protected QR corner across screen shapes. */
.draws-screen{position:relative;overflow:hidden;background:#fff;container-type:size;display:flex;align-items:center;justify-content:center}.draws-canvas{--draws-width:round(down,min(100cqw,calc(100cqh * 5 / 3)),5px);position:absolute;left:round(down,calc((100cqw - var(--draws-width)) / 2),1px);top:round(down,calc((100cqh - var(--draws-width) * 3 / 5) / 2),1px);width:var(--draws-width);aspect-ratio:5/3}.draws-art{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}.draws-join{position:absolute;right:0;bottom:0;width:round(down,24%,1px);height:round(down,50%,1px);border:2px solid #000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:4px;overflow:hidden}.draws-qr{width:100%;min-height:0;flex:1;object-fit:contain;image-rendering:pixelated;background:#fff}.draws-code{flex-shrink:0;align-self:stretch;display:flex;flex-direction:column;line-height:1;white-space:normal;text-align:center}
</style>
