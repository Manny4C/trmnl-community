<div class="layout layout--col"><div class="wc wc--full wc--{{ density | default: 'compact' }} wc-count-{{ headline_count | default: 8 }}" style="--wc-rows:{{ column_rows | default: 4 }}">
<div class="wc-head"><span class="wc-brand">THE DAILY TRMNL</span><span class="wc-topic">{{ topic_label | default: topic | capitalize }}</span></div>
<div class="wc-label">{{ briefing_label | escape }} · {{ stories.size }} headline{% if stories.size != 1 %}s{% endif %}{% if stale %} · Cached{% endif %}{% if unavailable_sources.size > 0 %} · Partial sources{% endif %}</div>
<div class="wc-list">{% for story in stories limit: headline_count %}<div class="wc-card"><div class="wc-title">{% if story.change != blank %}<span class="wc-badge">{{ story.change }}</span>{% endif %}{{ story.title | escape }}</div><div class="wc-snippet">{{ story.snippet | escape }}</div><div class="wc-source">{{ story.source | escape }} · {% if story.time_kind == "indexed" %}Indexed {% endif %}{{ story.published_at | date: "%b %d" }}</div></div>{% else %}<div class="wc-empty">{% if no_matches %}No matching stories yet.<br>Try a broader news prompt.{% else %}Briefing temporarily unavailable.<br>Please check again later.{% endif %}</div>{% endfor %}</div>
<div class="wc-foot"><span>Checked {{ fetched_at | date: "%b %d %H:%M" }} UTC</span><span>the-daily-trmnl.vercel.app</span></div>
</div></div>
