<div class="layout layout--col"><div class="wc wc--quadrant">
  <div class="wc-head"><span class="wc-brand">WHAT CHANGED?</span><span class="wc-topic">{{ topic | capitalize }}</span></div>
  <div class="wc-label">{{ briefing_label | escape }}{% if stale %} · Cached{% endif %}{% if unavailable_sources.size > 0 %} · Partial sources{% endif %}</div>
  <div class="wc-list">
  {% for story in stories limit: 1 %}
    <div class="wc-card">
      <div class="wc-title">{% if story.change != blank %}<span class="wc-badge">{{ story.change }}</span>{% endif %}{{ story.title | escape }}</div>
      <div class="wc-snippet">{{ story.snippet | escape }}</div>
      <div class="wc-source">{{ story.source | escape }} · {{ story.published_at | date: "%b %d" }}</div>
    </div>
  {% else %}<div class="wc-empty">Briefing temporarily unavailable.<br>Please check again later.</div>{% endfor %}
  </div>
  <div class="wc-foot"><span>{{ topic | capitalize }} · Checked {{ fetched_at | date: "%b %d %H:%M" }} UTC</span><span>what-changed-nine.vercel.app</span></div>
</div></div>
