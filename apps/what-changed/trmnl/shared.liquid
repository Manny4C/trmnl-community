{% comment %}Native Framework items and overflow fit every available item to OG/X and portrait mashups.{% endcomment %}
{% template feed_view %}
{% assign item_limit = headline_count | default: 8 | plus: 0 %}
<div class="layout layout--col gap--small wc--{{ mode }}">
<span class="title title--small lg:title--base text--red 1bit:text--black 2bit:text--black 4bit:text--black" data-clamp="1">THE DAILY TRMNL</span>
<span class="label label--small lg:label--base w--full" data-clamp="2">{{ briefing_label | escape }} · {{ topic_label | default: topic | escape }}{% if stale %} · CACHED{% endif %}{% if unavailable_sources.size > 0 %} · PARTIAL{% endif %}</span>

{% if stories.size > 0 %}
<div class="columns stretch w--full" data-overflow-max-cols="{{ max_cols }}" data-overflow-max-cols-lg="2" data-overflow-max-cols-portrait="1" data-overflow-max-cols-lg-portrait="{{ portrait_cols }}" data-overflow-counter="true">
<div class="column gap--xsmall">
{% for story in stories limit: item_limit %}
<div class="item wc-card"><div class="meta"><span class="index">{{ forloop.index }}</span></div><div class="content gap--none">
<span class="title title--small lg:title--base wc-title" data-clamp="{{ title_lines }}" data-clamp-lg="2">{% if story.change != blank %}<span class="label label--small bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black">{{ story.change | escape }}</span> {% endif %}{{ story.title | escape }}</span>
{% if item_limit <= 8 %}<span class="description {% if item_limit <= 3 %}description--large lg:description--xlarge{% endif %}" data-clamp="{% if item_limit <= 3 %}8{% else %}{{ description_lines }}{% endif %}" data-clamp-lg="{% if item_limit <= 3 %}12{% else %}3{% endif %}">{{ story.snippet | escape }}</span>{% endif %}
<span class="label label--small lg:label--base" data-clamp="1">{{ story.source | escape }} · {% if story.time_kind == "indexed" %}Indexed {% endif %}{{ story.published_at | date: "%b %d" }}</span>
</div></div>
{% endfor %}
</div></div>
{% else %}<div class="flex flex--col flex--center stretch w--full"><span class="description">{% if no_matches %}No matching stories yet. Try a broader news prompt.{% else %}Briefing temporarily unavailable. Please check again later.{% endif %}</span></div>{% endif %}
</div>
<div class="title_bar"><span class="title text--red 1bit:text--black 2bit:text--black 4bit:text--black">The Daily TRMNL</span><span class="instance">{{ fetched_at | date: "%b %d %H:%M" }} UTC</span></div>
{% endtemplate %}
