<div class="layout layout--col gap--xsmall lg:gap--large flex--top">
{% render 'scout_heading',mode_label:mode_label,filter_label:filter_label,stale:stale,partial:partial %}
{% if companies.size > 0 %}
<div class="columns" data-overflow-max-cols="2" data-overflow-max-cols-lg="2" data-overflow-max-cols-lg-portrait="1" data-overflow-counter="true">
<div class="column gap--xsmall lg:gap--large">
{% render 'scout_items',companies:companies,row_limit:10,name_size:'text--base lg:text--xxlarge lg:portrait:text--xxxlarge',description_size:'text--small lg:text--xlarge lg:portrait:text--xxlarge',lines:1,large_lines:2,portrait_lines:3 %}
</div></div>
{% else %}{% render 'scout_empty',total:total %}{% endif %}
{% render 'scout_links' %}
</div>{% render 'title_bar',fetched_at:fetched_at %}
