{% comment %}Native Framework items and overflow fit every available item to OG/X and portrait mashups.{% endcomment %}
{% template feed_view %}
{% assign item_limit = 10 | default: 10 | plus: 0 %}
<div class="layout layout--col gap--small sc--{{ mode }}">
<span class="title title--small lg:title--base text--red 1bit:text--black 2bit:text--black 4bit:text--black" data-clamp="1">YC SCOUT</span>
<span class="label label--small lg:label--base w--full" data-clamp="2">{{ filter_label | escape }} · {{ mode_label | escape }}{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL{% endif %}</span>

{% if companies.size > 0 %}
<div class="columns stretch w--full" data-overflow-max-cols="{{ max_cols }}" data-overflow-max-cols-lg="2" data-overflow-max-cols-portrait="1" data-overflow-max-cols-lg-portrait="{{ portrait_cols }}" data-overflow-counter="true">
<div class="column">
{% for company in companies limit: item_limit %}
<div class="item sc-card" data-launch-id="{{ company.id | escape }}"><div class="meta"><span class="index">{{ forloop.index }}</span></div><div class="content">
<span class="title title--small lg:title--base sc-title" data-clamp="{{ title_lines }}" data-clamp-lg="2">{{ company.name | escape }}</span>
<span class="description" data-clamp="{{ description_lines }}" data-clamp-lg="3">{{ company.description | escape }}</span>
<span class="label label--small lg:label--base" data-clamp="1">YC {{ company.batch | escape }} · Launch HN · {{ company.published_at | date: "%b %d, %Y" }}</span>
</div></div>
{% endfor %}
</div></div>
{% else %}<div class="flex flex--col flex--center stretch w--full"><span class="description">{% if total == 0 %}No matching launches. Try fewer filters or a wider window.{% else %}Launch sources unavailable. Please check again later.{% endif %}</span></div>{% endif %}
</div>
<div class="title_bar"><span class="title text--red 1bit:text--black 2bit:text--black 4bit:text--black">YC Scout</span><span class="instance">{{ fetched_at | date: "%b %d %H:%M" }} UTC</span></div>
{% endtemplate %}
