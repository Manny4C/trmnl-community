{% template title_bar %}
<div class="title_bar"><span class="title">YC Scout</span><span class="instance">{{ fetched_at | date: "%b %d %H:%M" }} UTC</span></div>
{% endtemplate %}
{% template scout_heading %}
<div class="flex flex--row flex--between portrait:flex--col portrait:flex--left gap--xsmall w--full">
<span class="title title--small lg:title--xxlarge text--red 1bit:text--black 2bit:text--black 4bit:text--black">YC SCOUT</span>
<span class="label label--small lg:label--large bg--yellow 1bit:bg--white 2bit:bg--white 4bit:bg--white text--black" data-clamp="1">{{ mode_label | escape }}</span>
</div>
<span class="label label--small lg:label--large w--full" data-clamp="1">{{ filter_label | escape }}{% if stale %} · CACHED{% endif %}{% if partial %} · PARTIAL SOURCES{% endif %}</span>
{% endtemplate %}
{% template scout_items %}
{% for company in companies limit: row_limit %}
<div class="item" data-launch-id="{{ company.id | escape }}">
<div class="meta"><span class="index">{{ forloop.index }}</span></div>
<div class="content gap--none">
<div class="flex flex--row flex--between gap--small w--full">
<span class="{{ name_size }} text--bold" data-clamp="1" data-clamp-lg="1">{{ company.name | escape }}</span>
<span class="label label--small lg:label--large" data-clamp="1">{{ company.batch | escape }} · {{ company.published_at | date: "%b %d" }}</span>
</div>
<span class="{{ description_size }} w--full" data-clamp="{{ lines }}" data-clamp-lg="{{ large_lines }}" data-clamp-lg-portrait="{{ portrait_lines }}">{{ company.description | escape }}</span>
</div></div>
{% endfor %}
{% endtemplate %}
{% template scout_empty %}
<div class="flex flex--col flex--center gap--small w--full h--full">
<span class="title title--small lg:title--large">{% if total == 0 %}No matching launches{% else %}Launch sources unavailable{% endif %}</span>
<span class="description lg:description--large">{% if total == 0 %}Try fewer filters or a wider window.{% else %}Please check again later.{% endif %}</span>
</div>
{% endtemplate %}
{% template scout_links %}<span class="label label--small lg:label--large w--full" data-clamp="1">Launch HN · yc-launch-scout.vercel.app</span>{% endtemplate %}
